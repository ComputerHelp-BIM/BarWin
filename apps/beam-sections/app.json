{
  "name": "Beam Sections",
  "status": "active",
  "order": 10,
  "summary": "Simply supported beam: L-section and sections A-A, B-B, C-C with the full reinforcement, and a true-scale sheet to download.",
  "features": [
    "Links to scale",
    "Laps and extras",
    "Ld and bent legs",
    "DXF, PDF, SVG sheets"
  ],
  "entry": "dist/beam-sections.html",
  "version": {
    "file": "src/beams.js",
    "pattern": "VERSION = '(\\d+\\.\\d+\\.\\d+)'"
  },
  "build": {
    "outputs": {
      "dist/beam-sections.html": "src/index.html"
    },
    "svgs": "src/beams.js"
  }
}
